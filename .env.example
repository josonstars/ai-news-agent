# .env.example —— 复制成 .env 后填入真实值
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

MAX_STEPS=25
REQUEST_TIMEOUT=60
MAX_RETRIES=2

WORKSPACE_DIR=./workspace
DB_PATH=./workspace/data/agent.db

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=